# ==============================================
# AYUDAR Animal Welfare - Environment Template
# ==============================================
# Copy this file to .env for local development and configure
# real secrets in Vercel Project Settings for production.

# PostgreSQL Database (Neon, Supabase Postgres, or RDS)
# Runtime pooled connection (for serverless queries)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ayudar_db?sslmode=require"

# Direct non-pooled connection for migrations (e.g. Neon direct, Supabase session mode 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/ayudar_db?sslmode=require"

# Session signing secret (minimum 32 random characters; required in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-at-least-32-chars-random-secret"

# Optional bootstrap credentials for `npx prisma db seed`
ADMIN_SEED_NAME="Ayudar Administrator"
ADMIN_SEED_EMAIL="admin@ayudar.org"
ADMIN_SEED_PASSWORD="replace-with-strong-password"

# Razorpay Live / Test Gateway Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Explicitly opt-in ONLY for non-production UI demos without Razorpay keys (never enable in prod)
ENABLE_DEMO_PAYMENTS="false"

# Object Storage — Option A: Neon Object Storage (S3-compatible, recommended when on Neon)
# Configured automatically by `neon deploy` using buckets in neon.ts (`assets` public_read, `rescues` private)
AWS_ENDPOINT_URL_S3=""
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Object Storage — Option B: Vercel Blob &/or Custom S3 / Cloudflare R2
# Vercel Blob Storage (if used instead of Neon Object Storage)
BLOB_READ_WRITE_TOKEN=""

# Optional custom S3 / R2 overrides for private rescue photos
PRIVATE_STORAGE_PROVIDER="s3"
PRIVATE_STORAGE_ENDPOINT=""
PRIVATE_STORAGE_BUCKET=""
PRIVATE_STORAGE_REGION="auto"
PRIVATE_STORAGE_ACCESS_KEY=""
PRIVATE_STORAGE_SECRET_KEY=""

# Optional Distributed Rate Limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Canonical site URL for SEO sitemap & OpenGraph
NEXT_PUBLIC_SITE_URL="https://www.ayudarindia.com"

# Optional AI Assistant LLM Provider (uses built-in triage & shelter rules if unset)
# Set EITHER OpenAI or Gemini (OpenAI takes priority if both are set)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
