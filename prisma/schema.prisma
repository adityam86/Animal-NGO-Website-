generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         String         @default("ADMIN") // SUPER_ADMIN, ADMIN, COORDINATOR, VET
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  auditLogs    AuditLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([role])
  @@index([isActive])
}

model AdminSession {
  id        String    @id @default(cuid())
  jti       String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ContactInquiry {
  id         String   @id @default(cuid())
  name       String
  phone      String?
  email      String
  subject    String
  message    String
  status     String   @default("New") // New, In Progress, Resolved, Archived
  adminNotes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Animal {
  id                String                @id @default(cuid())
  name              String
  type              String
  breed             String
  gender            String
  age               String
  color             String
  location          String
  status            String
  image             String
  vaccinated        Boolean               @default(false)
  dewormed          Boolean               @default(false)
  sterilized        Boolean               @default(false)
  rescueDate        DateTime
  shelter           String
  story             String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // Relations
  adoptionApps      AdoptionApplication[]
  sponsorships      Sponsorship[]
  medicalRecords    MedicalRecord[]
  vaccinations      Vaccination[]
  fundraisers       MedicalFundraiser[]
  shelterLocationId String?
  shelterLocation   ShelterLocation?      @relation(fields: [shelterLocationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([shelterLocationId])
  @@index([createdAt])
}

model RescueCase {
  id             String             @id @default(cuid())
  animalType     String
  emergencyLevel String
  location       String
  reporterName   String
  reporterPhone  String
  reporterEmail  String?
  photoUrl       String?
  audioUrl       String?
  latitude       Float?
  longitude      Float?
  assignedTeam   String?
  status         String
  reportedAt     DateTime           @default(now())
  description    String
  history        RescueCaseStatus[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
  @@index([emergencyLevel])
  @@index([reportedAt])
}

model RescueCaseStatus {
  id           String     @id @default(cuid())
  rescueCaseId String
  rescueCase   RescueCase @relation(fields: [rescueCaseId], references: [id], onDelete: Cascade)
  status       String
  time         String?
  done         Boolean    @default(false)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([rescueCaseId])
}

model Story {
  slug       String       @id
  title      String
  subtitle   String
  animal     String
  animalType String
  date       DateTime
  readTime   String
  coverImage String
  outcome    String
  excerpt    String
  phases     StoryPhase[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([date])
}

model StoryPhase {
  id          String   @id @default(cuid())
  storySlug   String
  story       Story    @relation(fields: [storySlug], references: [slug], onDelete: Cascade)
  phase       String
  title       String
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([storySlug])
}

model Volunteer {
  id             String                  @id @default(cuid())
  name           String
  age            Int
  phone          String
  email          String
  location       String?
  experience     String?
  status         String                  @default("Pending") // Pending, Approved, Rejected, Active, Inactive
  roles          VolunteerRole[]
  availabilities VolunteerAvailability[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model VolunteerRole {
  id          String    @id @default(cuid())
  volunteerId String
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  role        String

  @@index([volunteerId])
}

model VolunteerAvailability {
  id           String    @id @default(cuid())
  volunteerId  String
  volunteer    Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  availability String

  @@index([volunteerId])
}

model Donation {
  id                String    @id @default(cuid())
  amount            Float
  currency          String    @default("INR")
  purpose           String
  frequency         String
  donorName         String
  donorPhone        String
  donorEmail        String
  donorPan          String?
  paymentStatus     String    @default("Pending") // Pending, Completed, Failed
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique
  verifiedAt        DateTime?
  failureReason     String?
  fundraiserId      String?
  fundraiser        MedicalFundraiser? @relation(fields: [fundraiserId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([paymentStatus])
  @@index([purpose])
  @@index([fundraiserId])
  @@index([createdAt])
}

model AdoptionApplication {
  id            String   @id @default(cuid())
  applicantName String
  age           Int
  phone         String
  email         String
  address       String
  occupation    String
  hasPets       Boolean
  petDetails    String?
  homeType      String
  familyMembers Int
  reason        String
  status        String   @default("Pending") // Pending, Under Review, Interview Scheduled, Approved, Rejected, Adopted
  animalId      String?
  animal        Animal?  @relation(fields: [animalId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([animalId])
  @@index([createdAt])
}

model Sponsorship {
  id                String    @id @default(cuid())
  sponsorName       String
  sponsorPhone      String
  sponsorEmail      String
  animalId          String?
  animal            Animal?   @relation(fields: [animalId], references: [id], onDelete: SetNull)
  tier              String
  amount            Float
  currency          String    @default("INR")
  frequency         String    // One-time, Monthly
  paymentStatus     String    @default("Pending") // Pending, Completed, Failed
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([paymentStatus])
  @@index([animalId])
  @@index([createdAt])
}

model MedicalRecord {
  id        String   @id @default(cuid())
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  diagnosis String
  treatment String
  cost      Float    @default(0)
  vetName   String
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([animalId])
  @@index([date])
}

model Vaccination {
  id               String    @id @default(cuid())
  animalId         String
  animal           Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  vaccineName      String
  dateAdministered DateTime  @default(now())
  dateDue          DateTime?
  vetName          String
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([animalId])
  @@index([dateDue])
}

model ShelterLocation {
  id        String   @id @default(cuid())
  name      String
  address   String
  capacity  Int
  type      String
  animals   Animal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model MedicalFundraiser {
  id         String     @id @default(cuid())
  title      String
  animalName String
  species    String
  summary    String
  image      String
  goalInr    Float
  purpose    String     @default("Medical Treatment")
  isActive   Boolean    @default(true)
  animalId   String?
  animal     Animal?    @relation(fields: [animalId], references: [id], onDelete: SetNull)
  donations  Donation[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

model CommunityDrive {
  id          String   @id @default(cuid())
  title       String
  driveType   String   // Anti-Rabies Vaccination, ABC Sterilization, Feeding Camp, Awareness
  areaWard    String
  date        DateTime
  timeSlot    String
  coordinator String
  notes       String?
  status      String   @default("Scheduled") // Scheduled, Ongoing, Completed, Cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([status])
}

model GalleryPhoto {
  id           String   @id @default(cuid())
  title        String
  category     String   // Rescue, Gaushala, Shelter, Community Drive
  caption      String?
  imageUrl     String
  capturedDate DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([capturedDate])
}
